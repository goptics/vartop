<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>dev.goptics.vartop</string>
	<key>ProgramArguments</key>
	<array>
		<string>/opt/vartop dir/vartop</string>
		<string>daemon</string>
		<string>run</string>
	</array>
	<key>EnvironmentVariables</key>
	<dict>
		<key>HOME</key>
		<string>/home/u</string>
		<key>KUBECONFIG</key>
		<string>/home/u/.kube/a &#34;b&#34;%c$d&lt;e&gt;&amp;f</string>
		<key>PATH</key>
		<string>/opt/my tools/bin:/usr/bin</string>
	</dict>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<dict>
		<key>SuccessfulExit</key>
		<false/>
	</dict>
	<key>ThrottleInterval</key>
	<integer>10</integer>
</dict>
</plist>
