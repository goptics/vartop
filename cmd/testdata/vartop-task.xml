<?xml version="1.0" encoding="UTF-16"?>
<Task version="1.2" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <RegistrationInfo>
    <Description>vartop daemon: collects the configured varmq servers into vartop&#39;s history</Description>
  </RegistrationInfo>
  <Triggers>
    <LogonTrigger>
      <Enabled>true</Enabled>
      <UserId>DESKTOP\u</UserId>
    </LogonTrigger>
  </Triggers>
  <Principals>
    <Principal id="Author">
      <UserId>DESKTOP\u</UserId>
      <LogonType>InteractiveToken</LogonType>
      <RunLevel>LeastPrivilege</RunLevel>
    </Principal>
  </Principals>
  <Settings>
    <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>
    <DisallowStartIfOnBatteries>false</DisallowStartIfOnBatteries>
    <StopIfGoingOnBatteries>false</StopIfGoingOnBatteries>
    <ExecutionTimeLimit>PT0S</ExecutionTimeLimit>
    <RestartOnFailure>
      <Interval>PT1M</Interval>
      <Count>999</Count>
    </RestartOnFailure>
  </Settings>
  <Actions Context="Author">
    <Exec>
      <Command>C:\Program Files\vartop\vartop.exe</Command>
      <Arguments>daemon run --env &#34;KUBECONFIG=C:\Users\u\.kube\a \&#34;b\&#34;.yaml&#34; --env &#34;PATH=C:\Program Files\Git\bin;C:\Windows\\&#34; --env &#34;VARTOP_DATA_DIR=&#34; --env &#34;XDG_CACHE_HOME=&#34; --env &#34;XDG_CONFIG_HOME=&#34;</Arguments>
    </Exec>
  </Actions>
</Task>
